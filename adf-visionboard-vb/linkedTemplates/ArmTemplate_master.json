{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-visionboard-vb"
		},
		"LS_ADLS_MIGRATION_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_MIGRATION'"
		},
		"LS_LOCALSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_LOCALSQL'"
		},
		"LS_ADLS_MIGRATION_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsmigrationvisionboard.dfs.core.windows.net/"
		},
		"LS_LOCALSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "BOOK-QUHN666QL5"
		},
		"LS_LOCALSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "visionboard"
		},
		"LS_LOCALSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vamsiprp"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-visionboard-vb_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_MIGRATION_accountKey": {
						"value": "[parameters('LS_ADLS_MIGRATION_accountKey')]"
					},
					"LS_LOCALSQL_password": {
						"value": "[parameters('LS_LOCALSQL_password')]"
					},
					"LS_ADLS_MIGRATION_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_MIGRATION_properties_typeProperties_url')]"
					},
					"LS_LOCALSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_LOCALSQL_properties_typeProperties_server')]"
					},
					"LS_LOCALSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_LOCALSQL_properties_typeProperties_database')]"
					},
					"LS_LOCALSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_LOCALSQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}